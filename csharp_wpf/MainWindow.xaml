<Window x:Class="SerialForgeWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SERIALFORGE PRO // Hardware Protocol &amp; UART Analysis Terminal" 
        Height="820" Width="1240" MinHeight="620" MinWidth="900"
        Background="#080C14" Foreground="#E2E8F0"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Custom Dark ScrollBar -->
        <Style x:Key="CyberScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#1E293B" CornerRadius="3" Margin="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#070B14"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#070B14">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CyberScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#111A2E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#090E1A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#151E2E"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button -->
        <ControlTemplate x:Key="CyberComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#070B14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#070B14"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource CyberComboBoxToggleButton}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="6,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0F172A" BorderThickness="1" BorderBrush="#38BDF8" CornerRadius="4" Margin="0,2,0,0"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#064E3B"/>
                                <Setter Property="Foreground" Value="#A7F3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#070B14"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#070B14"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#064E3B"/>
                    <Setter Property="Foreground" Value="#A7F3D0"/>
                    <Setter Property="BorderBrush" Value="#10B981"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Branding Section -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,4">
                    <Border CornerRadius="6" BorderBrush="#059669" BorderThickness="1" Margin="0,0,8,0" Width="36" Height="36" Background="#070B14" Padding="1">
                        <Border CornerRadius="5" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="TxtHeaderFallback" Text="💀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#10B981"/>
                                <Image x:Name="ImgHeaderIcon" Stretch="Uniform" Margin="0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SERIALFORGE PRO" FontWeight="Bold" FontSize="15" Foreground="#10B981" FontFamily="Consolas"/>
                            <Border Background="#022C22" BorderBrush="#059669" BorderThickness="1" CornerRadius="3" Margin="6,1,0,0" Padding="4,1">
                                <TextBlock Text="v2.0 // PROTOCOL FORGE" Foreground="#34D399" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtAppSubtitle" Text="HARDWARE PROTOCOL &amp; UART BRUTE-FORCE FRAMEWORK" Foreground="#64748B" FontSize="9" FontFamily="Consolas" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Presets Combo -->
                <Border Background="#070B14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLabelPreset" Text="📁 ПРЕСЕТ:" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" FontFamily="Consolas"/>
                        <ComboBox x:Name="CmbPresets" Width="145" SelectionChanged="CmbPresets_SelectionChanged">
                            <ComboBoxItem Content="PIN Code (4-Dig)" IsSelected="True"/>
                            <ComboBoxItem Content="Modbus RTU Register"/>
                            <ComboBoxItem Content="AT+AUTH Command"/>
                            <ComboBoxItem Content="Raw 2-Byte HEX"/>
                            <ComboBoxItem Content="Custom Protocol"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Port & Connect Controls -->
                <Border Background="#070B14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,10,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLabelPort" Text="PORT:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" FontFamily="Consolas"/>
                        <ComboBox x:Name="CmbPorts" Width="85" Margin="0,0,4,0" SelectionChanged="SettingControl_Changed"/>
                        <Button x:Name="BtnRefreshPorts" Content="⟳" Width="26" Height="24" FontSize="14" Padding="0,-2,0,0" Background="#111A2E" Foreground="#38BDF8" BorderBrush="#1E293B" Click="BtnRefreshPorts_Click" ToolTip="Обновить порты" Margin="0,0,8,0"/>

                        <TextBlock x:Name="TxtLabelBaud" Text="BAUD:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0" FontFamily="Consolas"/>
                        <ComboBox x:Name="CmbBaud" Width="90" SelectedIndex="4" Margin="0,0,8,0" SelectionChanged="SettingControl_Changed">
                            <ComboBoxItem Content="9600"/>
                            <ComboBoxItem Content="19200"/>
                            <ComboBoxItem Content="38400"/>
                            <ComboBoxItem Content="57600"/>
                            <ComboBoxItem Content="115200"/>
                            <ComboBoxItem Content="230400"/>
                            <ComboBoxItem Content="460800"/>
                            <ComboBoxItem Content="921600"/>
                            <ComboBoxItem Content="1000000"/>
                        </ComboBox>

                        <Button x:Name="BtnConnect" Content="⚡ ПОДКЛЮЧИТЬ" Background="#0369A1" Foreground="#FFFFFF" BorderBrush="#38BDF8" FontWeight="Bold" Padding="10,3" Click="BtnConnect_Click"/>
                    </StackPanel>
                </Border>

                <!-- Status Badges -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtBadgeHitsLabel" Text="🎯 HITS: " Foreground="#A7F3D0" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock x:Name="TxtHitsCountBadge" Text="0" Foreground="#34D399" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtBadgeSpeedLabel" Text="⚡ SPEED: " Foreground="#BAE6FD" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock x:Name="TxtSpeedBadge" Text="0 pkt/s" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E1B4B" BorderBrush="#312E81" BorderThickness="1" CornerRadius="4" Padding="6,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LedStatus" Width="7" Height="7" Fill="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="OFFLINE" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ================= 2. MAIN WORKSPACE ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" MinWidth="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN: ATTACK CONFIG ================= -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- SECTION 1: PAYLOAD & TEMPLATE -->
                        <Border Background="#111A2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtSec1Header" Text="1. ВЕКТОР АТАКИ И ШАБЛОН (PAYLOAD)" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton x:Name="RbTextMode" Content="ASCII/TEXT" IsChecked="True" Foreground="#94A3B8" FontSize="10" FontFamily="Consolas" Margin="0,0,8,0" Checked="Mode_Changed"/>
                                        <RadioButton x:Name="RbHexMode" Content="HEX BYTES" Foreground="#94A3B8" FontSize="10" FontFamily="Consolas" Checked="Mode_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="TxtTemplate" Text="PIN:{DEC:4}\r\n" Height="28" VerticalContentAlignment="Center" TextChanged="Template_Changed" Margin="0,0,0,6"/>

                                <!-- Macro Chips -->
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtMacroLabel" Text="Вставка макросов:" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,2" FontFamily="Consolas"/>
                                    <Button Content="{}{NUM}" Tag="{}{NUM}" Click="InsertMacro_Click" Background="#070B14" Foreground="#38BDF8" BorderBrush="#1E293B" Padding="4,1" FontSize="9" Margin="0,0,3,2"/>
                                    <Button Content="{}{DEC:4}" Tag="{}{DEC:4}" Click="InsertMacro_Click" Background="#070B14" Foreground="#34D399" BorderBrush="#1E293B" Padding="4,1" FontSize="9" Margin="0,0,3,2"/>
                                    <Button Content="{}{HEX:2}" Tag="{}{HEX:2}" Click="InsertMacro_Click" Background="#070B14" Foreground="#F59E0B" BorderBrush="#1E293B" Padding="4,1" FontSize="9" Margin="0,0,3,2"/>
                                    <Button Content="{}{HEX:4}" Tag="{}{HEX:4}" Click="InsertMacro_Click" Background="#070B14" Foreground="#F59E0B" BorderBrush="#1E293B" Padding="4,1" FontSize="9" Margin="0,0,3,2"/>
                                    <Button Content="\r" Tag="\r" Click="InsertMacro_Click" Background="#070B14" Foreground="#94A3B8" BorderBrush="#1E293B" Padding="4,1" FontSize="9" Margin="0,0,3,2"/>
                                    <Button Content="\n" Tag="\n" Click="InsertMacro_Click" Background="#070B14" Foreground="#94A3B8" BorderBrush="#1E293B" Padding="4,1" FontSize="9" Margin="0,0,3,2"/>
                                    <Button Content="\r\n" Tag="\r\n" Click="InsertMacro_Click" Background="#070B14" Foreground="#94A3B8" BorderBrush="#1E293B" Padding="4,1" FontSize="9" Margin="0,0,3,2"/>
                                    <Button Content="\0" Tag="\0" Click="InsertMacro_Click" Background="#070B14" Foreground="#94A3B8" BorderBrush="#1E293B" Padding="4,1" FontSize="9" Margin="0,0,0,2"/>
                                </WrapPanel>

                                <!-- Live Packet Inspector -->
                                <Border Background="#070B14" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtInspectorLabel" Text="ИНСПЕКТОР ТЕКУЩЕГО ПАКЕТА (PREVIEW):" Foreground="#64748B" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                                        <TextBlock x:Name="TxtPreviewText" Text="PIN:0000\r\n" Foreground="#38BDF8" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Margin="0,3,0,1"/>
                                        <TextBlock x:Name="TxtPreviewHex" Text="50 49 4E 3A 30 30 30 30 0D 0A" Foreground="#34D399" FontFamily="Consolas" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: RANGE & TIMING -->
                        <Border Background="#111A2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="TxtSec2Header" Text="2. ДИАПАЗОН ПЕРЕБОРА И ТАЙМИНГ" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas" Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock x:Name="TxtLabelStart" Text="СТАРТ" Foreground="#64748B" FontSize="9" FontFamily="Consolas"/>
                                        <TextBox x:Name="TxtStartNum" Text="0" Margin="0,2,0,0" TextChanged="Range_Changed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                        <TextBlock x:Name="TxtLabelEnd" Text="КОНЕЦ" Foreground="#64748B" FontSize="9" FontFamily="Consolas"/>
                                        <TextBox x:Name="TxtEndNum" Text="9999" Margin="0,2,0,0" TextChanged="Range_Changed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="2,0,2,0">
                                        <TextBlock x:Name="TxtLabelStep" Text="ШАГ" Foreground="#64748B" FontSize="9" FontFamily="Consolas"/>
                                        <TextBox x:Name="TxtStep" Text="1" Margin="0,2,0,0" TextChanged="Range_Changed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="3,0,0,0">
                                        <TextBlock x:Name="TxtLabelDelay" Text="ПАУЗА (МС)" Foreground="#64748B" FontSize="9" FontFamily="Consolas"/>
                                        <TextBox x:Name="TxtDelayMs" Text="25" Margin="0,2,0,0" TextChanged="Range_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress Bar -->
                                <Grid Margin="0,2,0,2">
                                    <TextBlock x:Name="TxtProgressPercent" Text="0.0% (0 / 9999)" HorizontalAlignment="Center" Foreground="#94A3B8" FontSize="10" FontFamily="Consolas"/>
                                </Grid>
                                <ProgressBar x:Name="PbSweep" Height="6" Background="#070B14" Foreground="#10B981" BorderBrush="#1E293B" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: STOP CRITERIA -->
                        <Border Background="#111A2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="ChkStopOnMatch" IsChecked="True" Content="ОСТАНОВИТЬ ПРИ СОВПАДЕНИИ ОТВЕТА (TRIGGER)" FontWeight="Bold" Foreground="#34D399" FontSize="10" FontFamily="Consolas" Margin="0,0,0,6" Click="SettingControl_Changed"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="CmbMatchMode" SelectedIndex="0" Margin="0,0,4,0" SelectionChanged="SettingControl_Changed">
                                        <ComboBoxItem Content="Contains String"/>
                                        <ComboBoxItem Content="Exact HEX Bytes"/>
                                        <ComboBoxItem Content="Regex Pattern"/>
                                        <ComboBoxItem Content="Any Response"/>
                                    </ComboBox>

                                    <TextBox x:Name="TxtStopPattern" Grid.Column="1" Text="ACCESS_GRANTED|OK|SUCCESS" VerticalContentAlignment="Center" TextChanged="Range_Changed"/>
                                </Grid>

                                <TextBlock x:Name="TxtTriggerHint" Text="⚡ При срабатывании условия сканер сохранит валидный ключ в таблицу и выведет баннер." Foreground="#64748B" FontSize="9" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- CONTROL BUTTONS -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnStart" Grid.Column="0" Content="▶ СТАРТ" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Height="32" Margin="0,0,3,0" Click="BtnStart_Click"/>
                            <Button x:Name="BtnPause" Grid.Column="1" Content="❚❚ ПАУЗА" Background="#B45309" Foreground="#FFFFFF" FontWeight="Bold" Height="32" Margin="2,0,2,0" IsEnabled="False" Click="BtnPause_Click"/>
                            <Button x:Name="BtnStop" Grid.Column="2" Content="■ СТОП" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" Height="32" Margin="3,0,0,0" IsEnabled="False" Click="BtnStop_Click"/>
                        </Grid>

                        <Button x:Name="BtnSingleProbe" Content="⚡ ОТПРАВИТЬ ОДИН ТЕСТОВЫЙ ПАКЕТ (PROBE)" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Height="30" Click="BtnSingleProbe_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= RIGHT COLUMN: TERMINAL & HITS ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- TOP HIT BANNER -->
                <Border x:Name="BannerLatestHit" Visibility="Collapsed" Grid.Row="0" Background="#022C22" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHitBannerTitle" Text="🎯 НАЙДЕНО СОВПАДЕНИЕ / VALID KEY!" FontWeight="Bold" Foreground="#10B981" FontSize="11" FontFamily="Consolas"/>
                            <TextBlock x:Name="TxtFoundKeyInfo" Text="Ключ: 1337 (0x539) | Ответ: ACCESS_GRANTED" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnCopyHitBanner" Content="📋 Скопировать" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#10B981" Foreground="#080C14" FontWeight="Bold" Padding="10,4" Click="BtnCopyHit_Click"/>
                    </Grid>
                </Border>

                <!-- LIVE TERMINAL -->
                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTerminalHeader" Text="ЖУРНАЛ ОБМЕНА ТРАФИКА (LIVE STREAM)" FontWeight="Bold" Foreground="#38BDF8" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Margin="6,0,0,0" Padding="4,1">
                                    <TextBlock Text="TX + RX" Foreground="#38BDF8" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtTerminalCount" Text="0 сообщений" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas"/>
                                <CheckBox x:Name="ChkAutoScroll" Content="Автопрокрутка" IsChecked="True" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" Click="SettingControl_Changed"/>
                                <Button x:Name="BtnCopyTerminal" Content="Скопировать" Click="BtnCopyLog_Click" Margin="0,0,4,0"/>
                                <Button x:Name="BtnClearTerminal" Content="Очистить" Click="BtnClearLog_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="TxtTerminalLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#060A12" Foreground="#34D399" BorderBrush="#1E293B" BorderThickness="1" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Padding="6"/>
                    </Grid>
                </Border>

                <!-- CAPTURED HITS TABLE -->
                <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHitsTableHeader" Text="ТАБЛИЦА СОВПАДЕНИЙ (CAPTURED HITS)" FontWeight="Bold" Foreground="#10B981" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <Border Background="#022C22" BorderBrush="#059669" BorderThickness="1" CornerRadius="3" Margin="6,0,0,0" Padding="4,1">
                                    <TextBlock x:Name="TxtHitsGridCount" Text="0 найдено" Foreground="#34D399" FontSize="9" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>

                            <Button x:Name="BtnExportCsv" Content="💾 Экспорт в CSV" HorizontalAlignment="Right" Background="#070B14" Foreground="#38BDF8" BorderBrush="#1E293B" Padding="6,2" FontSize="9" Click="BtnExportCsv_Click"/>
                        </Grid>

                        <DataGrid x:Name="DgHits" Grid.Row="1" AutoGenerateColumns="False" Background="#060A12" Foreground="#E2E8F0" RowBackground="#0F172A" AlternatingRowBackground="#111A2E" BorderBrush="#1E293B" GridLinesVisibility="Horizontal" HeadersVisibility="Column" IsReadOnly="True" FontSize="11" FontFamily="Consolas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="75"/>
                                <DataGridTextColumn Header="Значение" Binding="{Binding KeyNum}" Width="85"/>
                                <DataGridTextColumn Header="HEX Ключа" Binding="{Binding KeyHex}" Width="85"/>
                                <DataGridTextColumn Header="Отправлено (TX)" Binding="{Binding Sent}" Width="150"/>
                                <DataGridTextColumn Header="Ответ устройства (RX)" Binding="{Binding Response}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 3. BOTTOM BAR (STATUS, LANGUAGE & HARDWARE TELEMETRY) ================= -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtTelemetry" Text="[READY] Движок готов к работе. Подключите COM-порт и нажмите СТАРТ." FontFamily="Consolas" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>

                <!-- Right Side Controls: CPU & RAM Badges + Language Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Creator Badge -->
                    <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Ideation: " Foreground="#9CA3AF" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="X80CT" Foreground="#F3F4F6" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text=" | Code: " Foreground="#9CA3AF" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="Gemini" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- CPU Badge -->
                    <Border Background="#0B253A" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡ CPU: " Foreground="#38BDF8" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock x:Name="TxtCpuUsage" Text="0.0%" Foreground="#E0F2FE" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <!-- RAM Badge -->
                    <Border Background="#2E1065" BorderBrush="#9333EA" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧠 RAM: " Foreground="#C084FC" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock x:Name="TxtRamUsage" Text="0 MB" Foreground="#F3E8FF" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <!-- Narrow Cyber Language Switcher Button on the Far Right -->
                    <Button x:Name="BtnLangSwitch" Content="🌐 RU" Width="44" Height="22" Background="#111A2E" Foreground="#38BDF8" BorderBrush="#0284C7" FontWeight="Bold" FontSize="9.5" Padding="0" Margin="0" Click="BtnLangSwitch_Click" ToolTip="Сменить язык / Змінити мову / Switch language"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
