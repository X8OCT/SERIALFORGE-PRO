@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ========================================================
echo   SerialForge PRO — Запуск C# WPF приложения (.NET 8)
echo ========================================================
echo.
dotnet run
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo Попытка очистки кэша и повторного запуска...
    dotnet clean >nul 2>&1
    dotnet run
)
if %ERRORLEVEL% NEQ 0 (
    echo.
    echo --------------------------------------------------------
    echo [ИНФО] Если запуск завершился с ошибкой:
    echo 1. Убедитесь, что установлен .NET 8.0 SDK (x64)
    echo 2. Либо запустите сборку EXE через 'build_exe.bat'
    echo --------------------------------------------------------
    pause
)
